# Photon — clang-tidy config (Security & bugs honored via WarningsAsErrors; style stays warning-level)

Checks: >
  *,
  -abseil-*,
  -fuchsia-*,
  -google-*,
  -llvm-*,
  -llvmlibc-*,
  -android-*,
  -altera-*,
  -zircon-*,
  -modernize-use-trailing-return-type,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-make-member-function-const,
  -bugprone-easily-swappable-parameters,
  -misc-no-recursion

# ONLY stop the build for these critical categories:
WarningsAsErrors: "bugprone-*,cert-*,clang-analyzer-*,cppcoreguidelines-no-malloc"

# Project headers only (paths are often absolute in compile_commands — anchor on directory names)
HeaderFilterRegex: '.*[/\\](api|bot|shared|proto)([/\\].*)?$'

CheckOptions:
  - key:             bugprone-argument-comment.StrictMode
    value:           '1'
  - key:             performance-for-range-copy.WarnOnAllAutoCopy
    value:           '1'
